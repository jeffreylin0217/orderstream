KAFKA_BOOTSTRAP_SERVERS=<host:port>
KAFKA_TOPIC=<topic-name>
TABLE_ROOT=<file:///absolute/path/or/s3a://bucket/prefix>
CHECKPOINT_ROOT=<file:///absolute/path/or/s3a://bucket/checkpoints>
S3_ENDPOINT=<optional-local-s3-endpoint>
AWS_ACCESS_KEY_ID=<provided-at-runtime>
AWS_SECRET_ACCESS_KEY=<provided-at-runtime>
AWS_SESSION_TOKEN=<optional-session-token>
AWS_REGION=<region>
